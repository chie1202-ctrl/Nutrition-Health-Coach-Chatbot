OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PREDICT=768
MEAL_PLAN_NUM_PREDICT=3072
MEAL_PLAN_TEMPERATURE=0.1
OLLAMA_TEMPERATURE=0.3
OLLAMA_REASONING=false
# Global whole-blob memory truncate (default off). M2 uses per-component caps.
MEMORY_BUDGET_ENABLED=false
MEMORY_BUDGET_CHARS=3500
ACTIVE_TURN_MAX_CHARS=300
SESSION_SUMMARY_MAX_CHARS=800
CUMULATIVE_SUMMARY_MAX_CHARS=1200
ACTIVE_SESSION_TURN_LIMIT=4
RECENT_SESSION_SUMMARY_LIMIT=2
SUMMARY_MODEL=deepseek-r1:8b
SUMMARY_NUM_PREDICT=256
SUMMARY_TEMPERATURE=0.2
SUMMARY_REASONING=false
MEMORY_MODE=M2
SESSION_IDLE_TIMEOUT_MINUTES=30
ROLLUP_SESSION_THRESHOLD=3
# Eval runners: isolated SQLite (default backend/database/eval/health_coach_eval.db).
# Do not point this at production health_coach.db. Use --use-main-db only if intentional.
# EVAL_DB_PATH=backend/database/eval/health_coach_eval.db
# Optional: ChatGPT/OpenAI judge for semantic memory evaluation.
# OPENAI_API_KEY=<your-openai-api-key>
OPENAI_JUDGE_MODEL=gpt-4o-mini-2024-07-18
OPENAI_JUDGE_MAX_OUTPUT_TOKENS=600
OPENAI_JUDGE_TIMEOUT=60
